{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "prod",
      "inherits": "base",
      "displayName": "Production",
      "description": "Only gnp: AF_XDP ingest + the CUDA ring poller. No testing code."
    },
    {
      "name": "dev",
      "inherits": "base",
      "displayName": "Development",
      "description": "gnp plus testing/: gnp_sim, test_ring and ctest.",
      "cacheVariables": { "GNP_BUILD_TESTING": "ON" }
    },
    {
      "name": "debug",
      "inherits": "dev",
      "displayName": "Debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "gpunetio",
      "inherits": "base",
      "displayName": "GPU-direct receive (DOCA container)",
      "description": "Builds gnp_gpunetio. Run via scripts/doca-build.sh: needs the DOCA SDK, which has no Fedora build.",
      "cacheVariables": {
        "GNP_ENABLE_XDP": "OFF",
        "CMAKE_CUDA_ARCHITECTURES": "75"
      }
    }
  ],
  "buildPresets": [
    { "name": "prod", "configurePreset": "prod" },
    { "name": "dev", "configurePreset": "dev" },
    { "name": "debug", "configurePreset": "debug" },
    { "name": "gpunetio", "configurePreset": "gpunetio" }
  ],
  "testPresets": [
    { "name": "dev", "configurePreset": "dev", "output": { "outputOnFailure": true } },
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } }
  ]
}
