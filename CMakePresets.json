{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "prod",
      "inherits": "base",
      "displayName": "Production",
      "description": "Only gnp: AF_XDP ingest + CUDA poller (CPU poller if nvcc is missing). No testing code."
    },
    {
      "name": "dev",
      "inherits": "base",
      "displayName": "Development (auto-detect CUDA)",
      "description": "gnp plus testing/: gnp_sim, test_ring and ctest.",
      "cacheVariables": { "GNP_BUILD_TESTING": "ON" }
    },
    {
      "name": "dev-cpu",
      "inherits": "dev",
      "displayName": "Development (force CPU poller)",
      "description": "Ignores any installed CUDA toolkit. Useful for fast protocol iteration.",
      "cacheVariables": { "GNP_ENABLE_CUDA": "OFF" }
    },
    {
      "name": "debug",
      "inherits": "dev",
      "displayName": "Debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    }
  ],
  "buildPresets": [
    { "name": "prod", "configurePreset": "prod" },
    { "name": "dev", "configurePreset": "dev" },
    { "name": "dev-cpu", "configurePreset": "dev-cpu" },
    { "name": "debug", "configurePreset": "debug" }
  ],
  "testPresets": [
    { "name": "dev", "configurePreset": "dev", "output": { "outputOnFailure": true } },
    { "name": "dev-cpu", "configurePreset": "dev-cpu", "output": { "outputOnFailure": true } },
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } }
  ]
}
